#include <tunables/global>

profile aa-geoserver flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # R2: explicit reads only (was /** rm bulk grant)
  / r,
  /**/ r,
  /usr/ r,
  /usr/** rm,
  /lib/ r,
  /lib/** rm,
  /lib64/ r,
  /lib64/** rm,
  /etc/ r,
  /etc/** r,
  /proc/ r,
  /proc/** r,
  /sys/ r,
  /sys/** r,
  /root/.cache/ rwkm,
  /root/.cache/** rwkm,

  # network: serving only; raw sockets revoked in R2
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  # R2 exec: enumerated startup toolchain (was /bin/** /usr/bin/** dir grants)
  /bin/sh ix,
  /bin/grep ix,
  /bin/sed ix,
  /bin/cat ix,
  /bin/cp ix,
  /bin/rm ix,
  /bin/mkdir ix,
  /bin/chmod ix,
  /bin/uname ix,
  /usr/bin/dirname ix,
  /usr/bin/basename ix,
  /usr/bin/getconf ix,
  /usr/bin/lscpu ix,
  /usr/local/openjdk-17/bin/java ix,
  /usr/local/openjdk-17/** ix,

  # R2: tmpdir relocated off /tmp (java.io.tmpdir=/run/aa-tmp/geo);
  # all /tmp globs from R0 (start_*, jetty*, geoserver*, hsperfdata) removed
  /mnt/geoserver/ rwkm,
  /mnt/geoserver/** rwkm,
  /run/aa-tmp/ rwkm,
  /run/aa-tmp/geo/ rwkm,
  /run/aa-tmp/geo/** rwkm,
}
