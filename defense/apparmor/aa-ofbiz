#include <tunables/global>

profile aa-ofbiz flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # R2: explicit reads only (was /** rm bulk grant)
  / r,
  /**/ r,
  /usr/ r,
  /usr/** rm,
  /lib/ r,
  /lib/** rm,
  /lib64/ r,
  /lib64/** rm,
  /etc/ r,
  /etc/** r,
  /root/ r,
  /root/** rm,
  /proc/ r,
  /proc/** r,
  /sys/ r,
  /sys/** r,

  # network: serving only; raw sockets revoked in R2
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  # exec: JVM only (unchanged from R0)
  /usr/local/openjdk-8/bin/java ix,
  /usr/local/openjdk-8/** ix,

  # R2: tmpdir relocated off /tmp (java.io.tmpdir=/run/aa-tmp/ofbiz);
  # hsperfdata rules removed (JVM runs with -XX:-UsePerfData)
  /usr/src/apache-ofbiz/ rwkm,
  /usr/src/apache-ofbiz/** rwkm,
  /run/aa-tmp/ rwkm,
  /run/aa-tmp/ofbiz/ rwkm,
  /run/aa-tmp/ofbiz/** rwkm,
}
