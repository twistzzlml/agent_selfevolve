[core]
	repositoryformatversion = 1
	filemode = false
	bare = false
	logallrefupdates = true
	ignorecase = true
[remote "origin"]
	url = https://github.com/vulhub/vulhub.git
	fetch = +refs/heads/master:refs/remotes/origin/master
	promisor = true
	partialclonefilter = blob:none
[extensions]
	worktreeConfig = true
[branch "master"]
	remote = origin
	merge = refs/heads/master
